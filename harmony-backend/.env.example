# Copy to .env for local dev. On Render, set these in the dashboard's
# Environment tab instead — never commit a real .env file.

PORT=3001
ALLOWED_ORIGINS=https://hatcm.com,https://www.hatcm.com

# Google Calendar OAuth (set up once by the developer, in Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://harmony-backend.onrender.com/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=one-time-obtained-refresh-token
GOOGLE_CALENDAR_ID=primary

# Shared passcode for her calendar helper dashboard — give this to her
# directly (not over an insecure channel), don't reuse it elsewhere.
ADMIN_PASSCODE=AzureDuan
