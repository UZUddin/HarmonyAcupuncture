# Copy to .env for local dev. On Render, set these in the dashboard's
# Environment tab instead — never commit a real .env file.

PORT=3001
ALLOWED_ORIGINS=https://hatcm.com,https://www.hatcm.com

# Google Calendar — Service Account auth (not OAuth). Set up once by the
# developer inside her Google Cloud project. See services/googleCalendar.js
# for the full setup steps.
#
# GOOGLE_SERVICE_ACCOUNT_KEY is the ENTIRE contents of the downloaded JSON
# key file, minified to a single line. Paste it as one long value.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}

# HER calendar's ID — for a personal Gmail account this is just her email
# address (e.g. harmony@gmail.com). Do NOT use "primary" — that only means
# something for the account that's actually authenticated, and a service
# account has no calendar of its own.
GOOGLE_CALENDAR_ID=her-actual-email@gmail.com

# Shared passcode for her calendar helper dashboard — give this to her
# directly (not over an insecure channel), don't reuse it elsewhere.
ADMIN_PASSCODE=AzureDuan
